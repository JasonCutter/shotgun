# 로컬 개발용 예시 값입니다. 실제 비밀값은 .env 파일에만 저장합니다.
DATABASE_URL=postgres://shotgun:shotgun@localhost:5432/shotgun
# Database-backed tests use TEST_DATABASE_URL from a separate .env.test file.
ASSET_STORAGE_ROOT=.data/assets
SHOTGUN_PG_TOOL_MODE=docker-compose
# RESTORE_DATABASE_URL must point to a different, empty Database.
# RESTORE_DATABASE_URL=postgres://shotgun:shotgun@localhost:5432/shotgun_restore_target
# RESTORE_ASSET_STORAGE_ROOT=.data/restore-assets
PORT=3000
HOST=127.0.0.1
ALLOW_EXTERNAL_BIND=false
NODE_ENV=development
SHOTGUN_DEVELOPMENT_AUTH=false
# Runtime source staging secret. Required for every normal runtime profile;
# use a locally generated value (32+ characters) and rotate only with a plan
# for existing sealed staging assets that still depend on the prior secret.
SOURCES_STAGING_SECRET=replace-with-at-least-32-character-staging-secret
# Runtime Discovery owner authority (required in production). This identifies
# an existing owner principal/membership; it does not grant authorization.
SHOTGUN_RUNTIME_OWNER_ACCOUNT_ID=local-owner
# One-time owner bootstrap inputs. These are consumed only by
# `npm run auth:bootstrap-owner`, never as runtime Discovery authority.
SHOTGUN_BOOTSTRAP_ACCOUNT_ID=replace-with-bootstrap-account-id
SHOTGUN_BOOTSTRAP_PASSWORD=replace-with-bootstrap-password
SHOTGUN_BOOTSTRAP_PROJECT_ID=shotgun
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Paid-service data terms and project logging settings must be verified before enabling this.
GEMINI_ALLOW_PRIVATE=false
# Provider-scoped deployment ceiling. Unknown provider IDs are ignored and the
# empty value denies private external transfer for every provider.
AI_PRIVATE_EGRESS_ALLOWED_PROVIDERS=
# Base64url encoding of exactly 32 random bytes; never commit a real value.
SHOTGUN_CREDENTIAL_MASTER_KEY=
SHOTGUN_CREDENTIAL_MASTER_KEY_VERSION=v1
