{
  "id": "stage11.action-execution",
  "version": "1.0.0",
  "owner": "Shotgun Risk-controlled External Action",
  "deployment": ["in_process", "worker"],
  "dataOwnership": ["action.executions", "action.approvals", "action.audit_events"],
  "produces": {
    "events": [{ "name": "ActionFeedbackRecorded", "range": ">=1.0.0 <2.0.0" }],
    "handoffs": [
      {
        "event": { "name": "ActionFeedbackRecorded", "range": ">=1.0.0 <2.0.0" },
        "target": {
          "kind": "consumer",
          "moduleId": "stage11.action-feedback-review"
        },
        "tags": ["DURABLE_OUTBOX", "REQUIRED_ACK"],
        "authority": "stage11.action-execution.feedback-outbox"
      }
    ]
  },
  "approvalPolicy": {
    "canWriteCanonical": false,
    "canExecuteExternalAction": true
  }
}
