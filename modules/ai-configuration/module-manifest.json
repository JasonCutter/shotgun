{
  "id": "a3.ai-configuration-authority",
  "version": "1.0.0",
  "owner": "Shotgun AI Configuration Authority",
  "compatibility": {
    "runtime": ">=1.0.0 <2.0.0",
    "contracts": [
      { "name": "ProviderRegistry", "range": ">=1.0.0 <2.0.0" },
      { "name": "ModelCatalog", "range": ">=1.0.0 <2.0.0" },
      { "name": "ProjectAIConfiguration", "range": ">=1.0.0 <2.0.0" }
    ]
  },
  "deployment": { "modes": ["in_process", "worker"] },
  "dataOwnership": {
    "owns": ["ai.project_ai_configurations", "ai.project_ai_configuration_revisions"],
    "readsViaPorts": ["CredentialMetadataReaderPort"],
    "directSchemaAccess": false
  },
  "consumes": { "commands": [], "events": [] },
  "produces": { "events": [], "handoffs": [] },
  "provides": {
    "queries": [
      { "name": "ProviderRegistry", "range": ">=1.0.0 <2.0.0" },
      { "name": "ModelCatalog", "range": ">=1.0.0 <2.0.0" },
      { "name": "ProjectAIConfiguration", "range": ">=1.0.0 <2.0.0" }
    ],
    "capabilities": [{ "name": "project-ai-configuration-authority", "priority": 100 }]
  },
  "requires": { "capabilities": [{ "name": "credential-metadata", "range": ">=1.0.0 <2.0.0" }] },
  "security": {
    "requiredContext": ["project", "provider", "model", "credential_revision"],
    "defaultOnMissingContext": "deny"
  },
  "approvalPolicy": {
    "canWriteCanonical": false,
    "canExecuteExternalAction": false
  }
}
