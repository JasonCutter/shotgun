  },
  "consumes": { "commands": [], "events": [] },
  "produces": { "events": [] },
  "provides": {
    "queries": [
      { "name": "SemanticEmbeddingProfile", "range": ">=1.0.0 <2.0.0" },
      { "name": "SemanticEmbeddingRegistry", "range": ">=1.0.0 <2.0.0" }
    ],
    "capabilities": [{ "name": "semantic-embedding-authority", "priority": 100 }]
  },
  "requires": { "capabilities": [] },
  "security": {
    "requiredContext": ["project", "provider", "model"],
    "defaultOnMissingContext": "deny"
  },
  "approvalPolicy": {
    "canWriteCanonical": false,
    "canExecuteExternalAction": false
  }
}
