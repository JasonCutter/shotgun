{
  "id": "stage5.semantic-embedding",
  "version": "1.0.0",
  "owner": "Shotgun Semantic Embedding Authority",
  "compatibility": {
    "runtime": ">=1.0.0 <2.0.0",
    "contracts": [
      { "name": "SemanticEmbeddingProfile", "range": ">=1.0.0 <2.0.0" },
      { "name": "SemanticEmbeddingRegistry", "range": ">=1.0.0 <2.0.0" }
    ]
  },
  "deployment": { "modes": ["in_process", "worker"] },
