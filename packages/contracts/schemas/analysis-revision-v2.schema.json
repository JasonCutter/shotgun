{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysisRevisionId",
    "contractVersion",
    "comparisonId",
    "candidate",
    "canonicalSnapshot",
    "inputDigest",
    "shortlistDigest",
    "comparedResourceIdentities",
    "providerIdentity",
    "credentialRevisionRef",
    "promptTemplateRevision",
    "outputSchemaRevision",
    "semanticPolicyRevision",
    "attempt",
    "state",
    "startedAt",
    "createdAt"
  ],
  "properties": {
    "analysisRevisionId": { "type": "string", "minLength": 1 },
    "contractVersion": { "const": "2.0" },
    "comparisonId": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "digest", "sourceVersionId", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "sourceVersionId": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "canonicalSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "inputDigest": { "type": "string", "minLength": 1 },
    "shortlistDigest": { "type": "string", "minLength": 1 },
    "comparedResourceIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceType", "resourceId", "resourceRevision"],
        "properties": {
          "resourceType": { "const": "CLAIM" },
          "resourceId": { "type": "string", "minLength": 1 },
          "resourceRevision": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "modelId", "capabilityId"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 }
      }
    },
    "credentialRevisionRef": { "type": "string", "minLength": 1 },
    "promptTemplateRevision": { "type": "string", "minLength": 1 },
    "outputSchemaRevision": { "type": "string", "minLength": 1 },
    "semanticPolicyRevision": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": [
        "PENDING",
        "ANALYZING",
        "COMPLETED",
        "SEMANTIC_UNAVAILABLE",
        "FAILED_RETRYABLE",
        "FAILED_TERMINAL",
        "POLICY_BLOCKED"
      ]
    },
    "outcome": {
      "enum": [
        "COMPLETED",
        "SEMANTIC_UNAVAILABLE",
        "FAILED_RETRYABLE",
        "FAILED_TERMINAL",
        "POLICY_BLOCKED"
      ]
    },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "durationMs": { "type": "number", "minimum": 0 },
    "outputDigest": { "type": "string", "minLength": 1 },
    "materialDigest": { "type": "string", "minLength": 1 },
    "safeFailureCode": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
