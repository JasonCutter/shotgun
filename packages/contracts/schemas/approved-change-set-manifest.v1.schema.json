{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestId",
    "changeSetId",
    "changeSetRevisionNumber",
    "projectId",
    "sourceVersionId",
    "candidateId",
    "candidateRevisionNumber",
    "claimText",
    "operation",
    "classification",
    "candidateDigest",
    "evidenceIds",
    "accessScope",
    "sensitivity",
    "expectedCanonicalVersion",
    "snapshotDigest",
    "diffDigest",
    "contentDigest",
    "approvalToken",
    "reason",
    "createdAt",
    "manifestDigest"
  ],
  "properties": {
    "manifestId": { "type": "string", "minLength": 1 },
    "changeSetId": { "type": "string", "minLength": 1 },
    "changeSetRevisionNumber": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceVersionId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateRevisionNumber": { "const": 1 },
    "claimText": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["ADD_CLAIM", "NO_OP"] },
    "classification": { "enum": ["NEW_CLAIM", "EXACT_DUPLICATE", "POSSIBLE_CONFLICT"] },
    "candidateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceIds": { "type": "array", "minItems": 1 },
    "accessScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sensitivity": { "enum": ["public", "internal", "private", "restricted"] },
    "expectedCanonicalVersion": { "type": "integer", "minimum": 0 },
    "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "diffDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "approvalToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenId",
        "changeSetId",
        "changeSetRevisionNumber",
        "actorId",
        "contentDigest",
        "expectedCanonicalVersion",
        "snapshotDigest",
        "issuedAt",
        "expiresAt",
        "tokenDigest"
      ],
      "properties": {
        "tokenId": { "type": "string", "minLength": 1 },
        "changeSetId": { "type": "string", "minLength": 1 },
        "changeSetRevisionNumber": { "const": 1 },
        "actorId": { "type": "string", "minLength": 1 },
        "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "expectedCanonicalVersion": { "type": "integer", "minimum": 0 },
        "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "issuedAt": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "minLength": 1 },
        "tokenDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "reason": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
