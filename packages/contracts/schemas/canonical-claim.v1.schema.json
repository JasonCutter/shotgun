{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "projectId",
    "revisionNumber",
    "claimText",
    "sourceVersionId",
    "evidenceIds",
    "createdFromManifestId",
    "accessScope",
    "sensitivity",
    "createdAt"
  ],
  "properties": {
    "claimId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "revisionNumber": { "const": 1 },
    "claimText": { "type": "string", "minLength": 1 },
    "sourceVersionId": { "type": "string", "minLength": 1 },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "createdFromManifestId": { "type": "string", "minLength": 1 },
    "accessScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sensitivity": { "enum": ["public", "internal", "private", "restricted"] },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
