{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commitId",
    "projectId",
    "manifestId",
    "manifestDigest",
    "changeSetId",
    "operation",
    "status",
    "beforeVersion",
    "afterVersion",
    "snapshotDigest",
    "revisionId",
    "historyEventId",
    "outboxId",
    "committedAt"
  ],
  "properties": {
    "commitId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "manifestId": { "type": ["string", "null"] },
    "manifestDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "changeSetId": { "type": ["string", "null"] },
    "authorityId": { "type": ["string", "null"] },
    "authorityDigest": { "type": ["string", "null"] },
    "operation": { "enum": ["ADD_CLAIM", "ADD_RELATION", "NO_OP"] },
    "status": { "enum": ["COMMITTED", "NO_OP"] },
    "beforeVersion": { "type": "integer", "minimum": 0 },
    "afterVersion": { "type": "integer", "minimum": 0 },
    "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "claimId": { "type": "string", "minLength": 1 },
    "relationId": { "type": "string", "minLength": 1 },
    "logicalIdentityKey": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "minLength": 1 },
    "historyEventId": { "type": "string", "minLength": 1 },
    "outboxId": { "type": "string", "minLength": 1 },
    "committedAt": { "type": "string", "minLength": 1 }
  }
}
