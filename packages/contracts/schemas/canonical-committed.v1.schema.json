{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commitId",
    "manifestId",
    "changeSetId",
    "operation",
    "status",
    "canonicalVersion",
    "snapshotDigest",
    "actorId",
    "accessScope",
    "sensitivity"
  ],
  "properties": {
    "commitId": { "type": "string", "minLength": 1 },
    "manifestId": { "type": ["string", "null"] },
    "changeSetId": { "type": ["string", "null"] },
    "operation": { "enum": ["ADD_CLAIM", "NO_OP"] },
    "status": { "enum": ["COMMITTED", "NO_OP"] },
    "canonicalVersion": { "type": "integer", "minimum": 0 },
    "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "claimId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "accessScope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sensitivity": { "enum": ["public", "internal", "private", "restricted"] }
  },
  "allOf": [
    {
      "description": "GPT Round 2 #5: only NO_OP payloads may carry an empty accessScope; ADD_CLAIM/COMMITTED keep the non-empty constraint.",
      "if": {
        "properties": { "operation": { "const": "ADD_CLAIM" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "accessScope": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
