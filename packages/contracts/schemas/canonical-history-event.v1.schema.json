{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "historyEventId",
    "projectId",
    "commitId",
    "manifestId",
    "changeSetId",
    "eventType",
    "beforeVersion",
    "afterVersion",
    "reason",
    "actor",
    "createdAt"
  ],
  "properties": {
    "historyEventId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "commitId": { "type": "string", "minLength": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "changeSetId": { "type": "string", "minLength": 1 },
    "eventType": { "enum": ["CANONICAL_CLAIM_ADDED", "CHANGESET_NO_OP"] },
    "beforeVersion": { "type": "integer", "minimum": 0 },
    "afterVersion": { "type": "integer", "minimum": 0 },
    "claimId": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "service", "system"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
