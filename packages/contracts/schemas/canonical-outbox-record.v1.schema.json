{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outboxId",
    "projectId",
    "aggregateId",
    "eventType",
    "payload",
    "status",
    "attempts",
    "availableAt"
  ],
  "properties": {
    "outboxId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "aggregateId": { "type": "string", "minLength": 1 },
    "eventType": { "const": "CanonicalCommitted" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitId",
        "manifestId",
        "changeSetId",
        "operation",
        "status",
        "canonicalVersion",
        "snapshotDigest",
        "actorId",
        "accessScope",
        "sensitivity"
      ],
      "properties": {
        "commitId": { "type": "string", "minLength": 1 },
        "manifestId": { "type": "string", "minLength": 1 },
        "changeSetId": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["ADD_CLAIM", "NO_OP"] },
        "status": { "enum": ["COMMITTED", "NO_OP"] },
        "canonicalVersion": { "type": "integer", "minimum": 0 },
        "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "claimId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "minLength": 1 },
        "accessScope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sensitivity": { "enum": ["public", "internal", "private", "restricted"] }
      }
    },
    "status": { "enum": ["pending", "processing", "published"] },
    "attempts": { "type": "integer", "minimum": 0 },
    "availableAt": { "type": "string", "minLength": 1 },
    "claimedAt": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string", "minLength": 1 },
    "lastError": { "type": "string" }
  }
}
