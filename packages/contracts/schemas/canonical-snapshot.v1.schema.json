{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotId", "projectId", "version", "digest", "claims", "createdAt"],
  "properties": {
    "snapshotId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "text", "revisionNumber", "evidenceIds"],
        "properties": {
          "claimId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "revisionNumber": { "type": "integer", "minimum": 1 },
          "evidenceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationId",
          "logicalIdentityKey",
          "revisionNumber",
          "relationType",
          "fromEndpoint",
          "toEndpoint",
          "direction",
          "evidenceIds"
        ],
        "properties": {
          "relationId": { "type": "string", "minLength": 1 },
          "logicalIdentityKey": { "type": "string", "minLength": 1 },
          "revisionNumber": { "type": "integer", "minimum": 1 },
          "relationType": { "type": "string", "minLength": 1 },
          "fromEndpoint": { "$ref": "#/definitions/approvedKnowledgeEntityRef" },
          "toEndpoint": { "$ref": "#/definitions/approvedKnowledgeEntityRef" },
          "direction": { "enum": ["DIRECTED", "UNDIRECTED"] },
          "validFrom": { "type": "string" },
          "validTo": { "type": "string" },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "createdAt": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "approvedKnowledgeEntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "authority", "resourceType", "resourceId", "resourceRevision"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "authority": { "const": "APPROVED_KNOWLEDGE" },
        "resourceType": { "const": "ENTITY" },
        "resourceId": { "type": "string", "minLength": 1 },
        "resourceRevision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
