{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shotgun.local/contracts/change-set-approved-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "rollout", "rolloutAuthorityRevision"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "manifestId",
        "contractVersion",
        "projectId",
        "manifestDigest",
        "userApproval",
        "operation",
        "candidate",
        "evidenceIds",
        "expectedCanonicalVersion",
        "snapshotDigest"
      ],
      "properties": {
        "manifestId": { "type": "string", "minLength": 1 },
        "contractVersion": { "const": "2.0" },
        "projectId": { "type": "string", "minLength": 1 },
        "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "operation": { "enum": ["ADD_CLAIM", "NO_OP", "MODIFY_REVIEW"] },
        "candidate": { "type": "object" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedCanonicalVersion": { "type": "integer", "minimum": 0 },
        "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "userApproval": { "type": "object" }
      }
    },
    "rollout": { "const": "V2_ACTIVE" },
    "rolloutAuthorityRevision": { "type": "string", "minLength": 1 }
  }
}
