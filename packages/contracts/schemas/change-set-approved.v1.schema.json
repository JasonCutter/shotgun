{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestId",
    "changeSetId",
    "candidateId",
    "operation",
    "contentDigest",
    "expectedCanonicalVersion",
    "approvalTokenDigest",
    "manifestDigest"
  ],
  "properties": {
    "manifestId": { "type": "string", "minLength": 1 },
    "changeSetId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["ADD_CLAIM", "NO_OP"] },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "expectedCanonicalVersion": { "type": "integer", "minimum": 0 },
    "approvalTokenDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
