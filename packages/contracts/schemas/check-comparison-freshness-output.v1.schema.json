{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["fresh", "currentSnapshotVersion", "currentSnapshotDigest"],
  "properties": {
    "fresh": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 1 },
    "currentSnapshotVersion": { "type": "integer", "minimum": 0 },
    "currentSnapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
