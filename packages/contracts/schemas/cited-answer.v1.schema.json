{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "projectedCanonicalVersion",
        "canonicalVersion",
        "lag",
        "canonicalSnapshotDigest"
      ],
      "properties": {
        "status": { "enum": ["READY", "STALE", "DEGRADED"] },
        "projectedCanonicalVersion": { "type": "integer", "minimum": 0 },
        "canonicalVersion": { "type": "integer", "minimum": 0 },
        "lag": { "type": "integer", "minimum": 0 },
        "projectedSnapshotDigest": { "type": "string" },
        "canonicalSnapshotDigest": { "type": "string" },
        "lastCommitId": { "type": "string" },
        "updatedAt": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "question", "statements", "readiness"],
  "properties": {
    "status": { "enum": ["ANSWERED", "NO_MATCH", "STALE_PROJECTION"] },
    "question": { "type": "string" },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "certainty", "citations"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "certainty": { "const": "CANONICAL" },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "citationId",
                "claimId",
                "revisionId",
                "evidenceId",
                "sourceVersionId",
                "exactQuote"
              ],
              "properties": {
                "citationId": { "type": "string" },
                "claimId": { "type": "string" },
                "revisionId": { "type": "string" },
                "evidenceId": { "type": "string" },
                "sourceVersionId": { "type": "string" },
                "exactQuote": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "readiness": { "$ref": "#/$defs/readiness" },
    "uncertainty": { "type": "string", "minLength": 1 }
  }
}
