{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisonId",
    "projectId",
    "sourceVersionId",
    "candidateId",
    "candidateRevisionNumber",
    "candidateDigest",
    "snapshotId",
    "snapshotVersion",
    "snapshotDigest",
    "classification",
    "similarity",
    "diff",
    "diffDigest",
    "recommendation",
    "accessScope",
    "sensitivity",
    "createdAt"
  ],
  "properties": {
    "comparisonId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceVersionId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateRevisionNumber": { "const": 1 },
    "candidateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "snapshotVersion": { "type": "integer", "minimum": 0 },
    "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "classification": { "enum": ["NEW_CLAIM", "EXACT_DUPLICATE", "POSSIBLE_CONFLICT"] },
    "matchedClaim": { "type": "object" },
    "similarity": { "type": "number", "minimum": 0, "maximum": 1 },
    "diff": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["equal", "insert", "delete"] },
          "value": { "type": "string" }
        }
      }
    },
    "diffDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "recommendation": { "enum": ["ADD_CLAIM", "NO_OP"] },
    "accessScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sensitivity": { "enum": ["public", "internal", "private", "restricted"] },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
