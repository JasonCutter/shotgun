{
  "$id": "https://shotgun.local/contracts/document-transformed.v1.schema.json",
  "title": "Document Transformed v1",
  "type": "object",
  "required": [
    "attemptId",
    "revisionId",
    "sourceId",
    "sourceVersionId",
    "transformerId",
    "transformerVersion",
    "documentHash",
    "sourceMapHash",
    "reusedRevision"
  ],
  "properties": {
    "attemptId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "revisionId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "sourceId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "sourceVersionId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "transformerId": { "type": "string", "minLength": 1 },
    "transformerVersion": { "type": "string", "minLength": 1 },
    "documentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceMapHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reusedRevision": { "type": "boolean" }
  },
  "additionalProperties": false
}
