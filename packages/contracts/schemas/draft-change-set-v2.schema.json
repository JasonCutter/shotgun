{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changeSetId",
    "contractVersion",
    "revisionNumber",
    "projectId",
    "candidate",
    "comparisonId",
    "comparisonDigest",
    "canonicalSnapshot",
    "analysisRevisionIds",
    "disposition",
    "relationshipIds",
    "evidenceIds",
    "operation",
    "reviewRecommendation",
    "status",
    "expectedCanonicalVersion",
    "snapshotDigest",
    "shortlistDigest",
    "freshnessIdentity",
    "freshnessDigest",
    "accessScope",
    "sensitivity",
    "contentDigest",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "changeSetId": { "type": "string", "minLength": 1 },
    "contractVersion": { "const": "2.0" },
    "revisionNumber": { "type": "integer", "minimum": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "digest", "sourceVersionId", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "sourceVersionId": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comparisonId": { "type": "string", "minLength": 1 },
    "comparisonDigest": { "type": "string", "minLength": 1 },
    "canonicalSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "minLength": 1 }
      }
    },
    "analysisRevisionIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "disposition": {
      "enum": [
        "NEW",
        "EXACT_DUPLICATE",
        "REVIEW_REQUIRED",
        "ANALYSIS_PENDING",
        "SEMANTIC_UNAVAILABLE",
        "POLICY_BLOCKED",
        "STALE"
      ]
    },
    "relationshipIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "operation": { "enum": ["ADD_CLAIM", "NO_OP", "MODIFY_REVIEW"] },
    "reviewRecommendation": { "enum": ["NO_OP", "ADD_CLAIM", "MODIFY_REVIEW", "HOLD"] },
    "status": { "enum": ["PENDING_REVIEW", "ON_HOLD", "APPROVED", "REJECTED", "STALE"] },
    "expectedCanonicalVersion": { "type": "integer", "minimum": 0 },
    "snapshotDigest": { "type": "string", "minLength": 1 },
    "shortlistDigest": { "type": "string", "minLength": 1 },
    "freshnessIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateRevision",
        "candidateSourceVersionId",
        "candidateDigest",
        "candidateEvidenceDigest",
        "canonicalSnapshotId",
        "canonicalSnapshotDigest",
        "canonicalSnapshotVersion",
        "shortlistDigest",
        "shortlistPolicyRevision",
        "semanticGenerationId",
        "semanticSourceProjectionDigest",
        "semanticCanonicalBaseVersion",
        "providerModelCapabilityIdentity",
        "promptTemplateRevision",
        "outputSchemaRevision",
        "semanticPolicyRevision"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "candidateRevision": { "type": "integer", "minimum": 1 },
        "candidateSourceVersionId": { "type": "string", "minLength": 1 },
        "candidateDigest": { "type": "string", "minLength": 1 },
        "candidateEvidenceDigest": { "type": "string", "minLength": 1 },
        "canonicalSnapshotId": { "type": "string", "minLength": 1 },
        "canonicalSnapshotDigest": { "type": "string", "minLength": 1 },
        "canonicalSnapshotVersion": { "type": "integer", "minimum": 0 },
        "shortlistDigest": { "type": "string", "minLength": 1 },
        "shortlistPolicyRevision": { "type": "string", "minLength": 1 },
        "accessSensitivityPolicyRevision": { "type": "string", "minLength": 1 },
        "semanticGenerationId": { "type": "string", "minLength": 1 },
        "semanticSourceProjectionDigest": { "type": "string", "minLength": 1 },
        "semanticCanonicalBaseVersion": { "type": "integer", "minimum": 0 },
        "providerModelCapabilityIdentity": { "type": "string", "minLength": 1 },
        "promptTemplateRevision": { "type": "string", "minLength": 1 },
        "outputSchemaRevision": { "type": "string", "minLength": 1 },
        "semanticPolicyRevision": { "type": "string", "minLength": 1 },
        "rolloutAuthorityRevision": { "type": "string", "minLength": 1 }
      }
    },
    "freshnessDigest": { "type": "string", "minLength": 1 },
    "accessScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sensitivity": { "enum": ["public", "internal", "private", "restricted"] },
    "contentDigest": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 }
  }
}
