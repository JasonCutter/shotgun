{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["call", "candidates"],
  "properties": {
    "call": { "$ref": "#/definitions/call" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimText", "evidenceId"],
        "properties": {
          "claimText": { "type": "string", "minLength": 1 },
          "evidenceId": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callId",
        "requestId",
        "taskProfile",
        "schemaName",
        "provider",
        "adapterVersion",
        "model",
        "modelVersion",
        "promptVersion",
        "policyVersion",
        "dataPolicyVersion",
        "dataClassification",
        "inputEvidenceIds",
        "usage",
        "cost",
        "attempts",
        "structuredOutputValid",
        "createdAt"
      ],
      "properties": {
        "callId": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "taskProfile": { "const": "candidate-extraction" },
        "schemaName": { "const": "ClaimCandidateBatch.v1" },
        "provider": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "promptVersion": { "const": "direct-claim-v1" },
        "policyVersion": { "const": "direct-only-v1" },
        "dataPolicyVersion": {
          "enum": ["gemini-stateless-no-sharing-v1", "fake-local-v1"]
        },
        "dataClassification": { "type": "string", "minLength": 1 },
        "inputEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens", "totalTokens"],
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "totalTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "status"],
          "properties": {
            "currency": { "const": "USD" },
            "status": { "enum": ["unavailable", "estimated"] },
            "amountMicros": { "type": "integer", "minimum": 0 }
          }
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attemptId", "attemptNumber", "status", "latencyMs"],
            "properties": {
              "attemptId": { "type": "string", "minLength": 1 },
              "attemptNumber": { "type": "integer", "minimum": 1 },
              "status": { "enum": ["succeeded", "failed"] },
              "errorCode": { "type": "string", "minLength": 1 },
              "providerResponseId": { "type": "string", "minLength": 1 },
              "latencyMs": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "structuredOutputValid": { "const": true },
        "createdAt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
