{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "taskProfile",
    "schemaName",
    "policyVersion",
    "dataClassification",
    "evidence"
  ],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "taskProfile": { "const": "candidate-extraction" },
    "schemaName": { "const": "ClaimCandidateBatch.v1" },
    "policyVersion": { "const": "direct-only-v1" },
    "dataClassification": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "text"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
