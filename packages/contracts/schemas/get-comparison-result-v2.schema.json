{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "projectId", "comparisonId", "accessScope", "sensitivity"],
  "properties": {
    "contractVersion": { "const": "2.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "comparisonId": { "type": "string", "minLength": 1 },
    "accessScope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sensitivity": { "enum": ["public", "internal", "private", "restricted"] }
  }
}
