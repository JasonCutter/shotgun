{
  "$id": "https://shotgun.local/contracts/get-evidence-spans-by-ids.v1.schema.json",
  "title": "Get Evidence Spans By IDs v1",
  "type": "object",
  "required": ["sourceVersionId", "revisionId", "evidenceIds"],
  "properties": {
    "sourceVersionId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "revisionId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f-]{36}$" }
    }
  },
  "additionalProperties": false
}
