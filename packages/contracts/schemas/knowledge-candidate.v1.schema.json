{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "modelOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "value", "evidenceIds"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commonProperties": {
      "candidateId": { "type": "string", "minLength": 1 },
      "revisionNumber": { "type": "integer", "minimum": 1 },
      "sourceVersionId": { "type": "string", "minLength": 1 },
      "evidenceIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "modelOutputs": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/modelOutput" }
      }
    }
  },
  "oneOf": [
    {
      "title": "EntityCandidate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateType",
        "revisionNumber",
        "sourceVersionId",
        "evidenceIds",
        "modelOutputs",
        "name",
        "entityKind",
        "aliases",
        "resolution"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/commonProperties/candidateId" },
        "candidateType": { "const": "ENTITY" },
        "revisionNumber": { "$ref": "#/$defs/commonProperties/revisionNumber" },
        "sourceVersionId": { "$ref": "#/$defs/commonProperties/sourceVersionId" },
        "evidenceIds": { "$ref": "#/$defs/commonProperties/evidenceIds" },
        "modelOutputs": { "$ref": "#/$defs/commonProperties/modelOutputs" },
        "name": { "type": "string", "minLength": 1 },
        "entityKind": { "enum": ["PERSON", "ORGANIZATION", "PLACE", "CONCEPT", "OTHER"] },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resolution": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": { "status": { "const": "NEW" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "canonicalEntityId"],
              "properties": {
                "status": { "const": "EXACT_MATCH" },
                "canonicalEntityId": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "possibleCanonicalEntityIds"],
              "properties": {
                "status": { "const": "POSSIBLY_SAME" },
                "possibleCanonicalEntityIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          ]
        }
      }
    },
    {
      "title": "RelationCandidate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateType",
        "revisionNumber",
        "sourceVersionId",
        "evidenceIds",
        "modelOutputs",
        "fromCandidateId",
        "toCandidateId",
        "relationType",
        "direction"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/commonProperties/candidateId" },
        "candidateType": { "const": "RELATION" },
        "revisionNumber": { "$ref": "#/$defs/commonProperties/revisionNumber" },
        "sourceVersionId": { "$ref": "#/$defs/commonProperties/sourceVersionId" },
        "evidenceIds": { "$ref": "#/$defs/commonProperties/evidenceIds" },
        "modelOutputs": { "$ref": "#/$defs/commonProperties/modelOutputs" },
        "fromCandidateId": { "type": "string", "minLength": 1 },
        "toCandidateId": { "type": "string", "minLength": 1 },
        "relationType": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["DIRECTED", "UNDIRECTED"] },
        "validFrom": { "type": "string", "minLength": 1 },
        "validTo": { "type": "string", "minLength": 1 },
        "temporalEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "properties": { "validFrom": {} }, "required": ["validFrom"] },
              { "properties": { "validTo": {} }, "required": ["validTo"] }
            ]
          },
          "then": {
            "properties": { "temporalEvidenceIds": {} },
            "required": ["temporalEvidenceIds"]
          }
        }
      ]
    },
    {
      "title": "EventCandidate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateType",
        "revisionNumber",
        "sourceVersionId",
        "evidenceIds",
        "modelOutputs",
        "title",
        "participantCandidateIds"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/commonProperties/candidateId" },
        "candidateType": { "const": "EVENT" },
        "revisionNumber": { "$ref": "#/$defs/commonProperties/revisionNumber" },
        "sourceVersionId": { "$ref": "#/$defs/commonProperties/sourceVersionId" },
        "evidenceIds": { "$ref": "#/$defs/commonProperties/evidenceIds" },
        "modelOutputs": { "$ref": "#/$defs/commonProperties/modelOutputs" },
        "title": { "type": "string", "minLength": 1 },
        "participantCandidateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "occurredAt": { "type": "string", "minLength": 1 },
        "temporalEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "occurredAt": {} }, "required": ["occurredAt"] },
          "then": {
            "properties": { "temporalEvidenceIds": {} },
            "required": ["temporalEvidenceIds"]
          }
        }
      ]
    },
    {
      "title": "DecisionCandidate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateType",
        "revisionNumber",
        "sourceVersionId",
        "evidenceIds",
        "modelOutputs",
        "decisionText"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/commonProperties/candidateId" },
        "candidateType": { "const": "DECISION" },
        "revisionNumber": { "$ref": "#/$defs/commonProperties/revisionNumber" },
        "sourceVersionId": { "$ref": "#/$defs/commonProperties/sourceVersionId" },
        "evidenceIds": { "$ref": "#/$defs/commonProperties/evidenceIds" },
        "modelOutputs": { "$ref": "#/$defs/commonProperties/modelOutputs" },
        "decisionText": { "type": "string", "minLength": 1 },
        "actorCandidateId": { "type": "string", "minLength": 1 }
      }
    },
    {
      "title": "ActionCandidate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateType",
        "revisionNumber",
        "sourceVersionId",
        "evidenceIds",
        "modelOutputs",
        "actionText",
        "executionStatus"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/commonProperties/candidateId" },
        "candidateType": { "const": "ACTION" },
        "revisionNumber": { "$ref": "#/$defs/commonProperties/revisionNumber" },
        "sourceVersionId": { "$ref": "#/$defs/commonProperties/sourceVersionId" },
        "evidenceIds": { "$ref": "#/$defs/commonProperties/evidenceIds" },
        "modelOutputs": { "$ref": "#/$defs/commonProperties/modelOutputs" },
        "actionText": { "type": "string", "minLength": 1 },
        "actorCandidateId": { "type": "string", "minLength": 1 },
        "dueAt": { "type": "string", "minLength": 1 },
        "temporalEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "executionStatus": { "const": "CANDIDATE_ONLY" }
      },
      "allOf": [
        {
          "if": { "properties": { "dueAt": {} }, "required": ["dueAt"] },
          "then": {
            "properties": { "temporalEvidenceIds": {} },
            "required": ["temporalEvidenceIds"]
          }
        }
      ]
    },
    {
      "title": "Conflict",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateType",
        "revisionNumber",
        "sourceVersionId",
        "evidenceIds",
        "modelOutputs",
        "subjectCandidateIds",
        "summary",
        "conflictKind"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/commonProperties/candidateId" },
        "candidateType": { "const": "CONFLICT" },
        "revisionNumber": { "$ref": "#/$defs/commonProperties/revisionNumber" },
        "sourceVersionId": { "$ref": "#/$defs/commonProperties/sourceVersionId" },
        "evidenceIds": { "$ref": "#/$defs/commonProperties/evidenceIds" },
        "modelOutputs": { "$ref": "#/$defs/commonProperties/modelOutputs" },
        "subjectCandidateIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "summary": { "type": "string", "minLength": 1 },
        "conflictKind": { "enum": ["FACTUAL", "TEMPORAL", "IDENTITY", "MODEL_DISAGREEMENT"] }
      }
    },
    {
      "title": "KnowledgeGap",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidateType",
        "revisionNumber",
        "sourceVersionId",
        "evidenceIds",
        "modelOutputs",
        "question",
        "relatedCandidateIds"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/commonProperties/candidateId" },
        "candidateType": { "const": "KNOWLEDGE_GAP" },
        "revisionNumber": { "$ref": "#/$defs/commonProperties/revisionNumber" },
        "sourceVersionId": { "$ref": "#/$defs/commonProperties/sourceVersionId" },
        "evidenceIds": { "$ref": "#/$defs/commonProperties/evidenceIds" },
        "modelOutputs": { "$ref": "#/$defs/commonProperties/modelOutputs" },
        "question": { "type": "string", "minLength": 1 },
        "relatedCandidateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
