{
  "$id": "https://shotgun.local/contracts/list-claim-candidates-by-revision-output.v1.schema.json",
  "title": "List Claim Candidates By Revision Output v1",
  "type": "object",
  "required": ["sourceVersionId", "revisionId", "items"],
  "properties": {
    "sourceVersionId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "revisionId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidateId",
          "batchId",
          "revisionNumber",
          "projectId",
          "sourceVersionId",
          "claimText",
          "evidenceIds",
          "evidenceMode",
          "extractionProfile",
          "status",
          "providerCall",
          "accessScope",
          "sensitivity",
          "createdAt"
        ],
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "batchId": { "type": "string", "minLength": 1 },
          "revisionNumber": { "const": 1 },
          "projectId": { "type": "string", "minLength": 1 },
          "sourceVersionId": { "type": "string", "minLength": 1 },
          "claimText": { "type": "string", "minLength": 1 },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceMode": { "const": "DIRECT_EVIDENCE" },
          "extractionProfile": { "const": "direct-only" },
          "status": { "enum": ["PENDING_VALIDATION", "READY", "REJECTED"] },
          "providerCall": { "type": "object" },
          "accessScope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sensitivity": { "enum": ["public", "internal", "private", "restricted"] },
          "createdAt": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
