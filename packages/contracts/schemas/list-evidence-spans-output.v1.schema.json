{
  "$id": "https://shotgun.local/contracts/list-evidence-spans-output.v1.schema.json",
  "title": "List Evidence Spans Output v1",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "pointer", "nodeKind", "position", "exactHash"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "pointer": { "type": "string", "pattern": "^(|/.*)$" },
          "nodeKind": { "enum": ["document", "paragraph", "sentence"] },
          "position": {
            "type": "object",
            "required": ["type", "start", "end", "unit"],
            "properties": {
              "type": { "const": "TextPositionSelector" },
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 },
              "unit": { "const": "unicode-code-point" }
            },
            "additionalProperties": false
          },
          "exactHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
