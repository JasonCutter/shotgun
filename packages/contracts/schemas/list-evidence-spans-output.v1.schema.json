{
  "$id": "https://shotgun.local/contracts/list-evidence-spans-output.v1.schema.json",
  "title": "List Evidence Spans Output v1",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "pointer", "nodeKind", "position", "exactHash"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "pointer": { "type": "string", "pattern": "^(|/.*)$" },
          "nodeKind": { "enum": ["document", "paragraph", "sentence"] },
          "position": {
            "type": "object",
            "required": ["type", "start", "end", "unit"],
            "properties": {
              "type": { "const": "TextPositionSelector" },
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 },
              "unit": { "const": "unicode-code-point" }
            },
            "additionalProperties": false
          },
          "selectors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": [
                    "PageSelector",
                    "BoundingBoxSelector",
                    "CellSelector",
                    "ShapeSelector",
                    "CssSelector"
                  ]
                },
                "page": { "type": "integer", "minimum": 1 },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number", "minimum": 0 },
                "height": { "type": "number", "minimum": 0 },
                "unit": { "enum": ["pt", "px"] },
                "sheet": { "type": "string" },
                "cell": { "type": "string" },
                "row": { "type": "integer", "minimum": 1 },
                "column": { "type": "integer", "minimum": 1 },
                "slide": { "type": "integer", "minimum": 1 },
                "shapeId": { "type": "string" },
                "value": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "exactHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
