{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "projectedCanonicalVersion",
    "canonicalVersion",
    "lag",
    "canonicalSnapshotDigest"
  ],
  "properties": {
    "status": { "enum": ["READY", "STALE", "DEGRADED"] },
    "projectedCanonicalVersion": { "type": "integer", "minimum": 0 },
    "canonicalVersion": { "type": "integer", "minimum": 0 },
    "lag": { "type": "integer", "minimum": 0 },
    "projectedSnapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "canonicalSnapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "lastCommitId": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 }
  }
}
