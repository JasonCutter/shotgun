{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonicalVersion", "snapshotDigest", "status"],
  "properties": {
    "commitId": { "type": "string", "minLength": 1 },
    "canonicalVersion": { "type": "integer", "minimum": 0 },
    "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "const": "READY" }
  }
}
