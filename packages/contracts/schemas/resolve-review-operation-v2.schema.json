{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resolve-review-operation-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changeSetId",
    "expectedDraftRevision",
    "expectedDraftDigest",
    "chosenOperation",
    "clientRequestId",
    "idempotencyKey"
  ],
  "properties": {
    "changeSetId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expectedDraftRevision": { "type": "integer", "minimum": 1 },
    "expectedDraftDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "chosenOperation": { "enum": ["ADD_CLAIM", "NO_OP"] },
    "clientRequestId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
