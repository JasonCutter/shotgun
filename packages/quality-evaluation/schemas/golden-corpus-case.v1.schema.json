{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shotgun.local/quality/golden-corpus-case.v1.schema.json",
  "title": "Shotgun Golden Corpus Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "caseVersion",
    "title",
    "description",
    "language",
    "sourceFormat",
    "sourceContent",
    "sourceContentHash",
    "projectContext",
    "sensitivity",
    "dataClassification",
    "expectedClaims",
    "queries",
    "tags",
    "difficulty",
    "riskCategory",
    "labelAuthor",
    "labelReviewStatus",
    "labelReviewedAt",
    "labelRevision",
    "provenance"
  ],
  "properties": {
    "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "caseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "language": { "enum": ["ko", "en", "ko-en-mixed"] },
    "sourceFormat": { "enum": ["plain-text", "markdown", "html-derived-text"] },
    "sourceContent": { "type": "string", "minLength": 1 },
    "sourceContentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "projectContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectKey", "accessScopes", "locale", "timezone"],
      "properties": {
        "projectKey": { "type": "string", "minLength": 1 },
        "accessScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "locale": { "type": "string", "minLength": 2 },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "sensitivity": { "enum": ["public", "internal", "private", "restricted"] },
    "dataClassification": { "const": "SYNTHETIC" },
    "expectedClaims": {
      "type": "array",
      "items": { "$ref": "#/definitions/goldenClaim" }
    },
    "expectedNoClaimReason": { "type": "string", "minLength": 1 },
    "queries": {
      "type": "array",
      "items": { "$ref": "#/definitions/searchQuery" }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "difficulty": { "enum": ["basic", "intermediate", "adversarial"] },
    "riskCategory": {
      "enum": [
        "normal",
        "numeric",
        "temporal",
        "negation",
        "uncertainty",
        "duplicate",
        "no-claim",
        "evidence-gap"
      ]
    },
    "labelAuthor": { "type": "string", "minLength": 1 },
    "labelReviewStatus": { "enum": ["CANDIDATE", "REVIEWED", "APPROVED", "RETIRED"] },
    "labelReviewedAt": { "type": "string", "format": "date-time" },
    "labelRevision": { "type": "integer", "minimum": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "license", "createdBy"],
      "properties": {
        "origin": { "const": "SHOTGUN_SYNTHETIC" },
        "license": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1 }
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "expectedClaims": { "type": "array", "maxItems": 0 } } },
      "then": {
        "properties": { "expectedNoClaimReason": { "type": "string", "minLength": 1 } },
        "required": ["expectedNoClaimReason"]
      },
      "else": { "not": { "required": ["expectedNoClaimReason"] } }
    }
  ],
  "definitions": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "unit"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "unit": { "const": "unicode-code-point" }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "position"],
      "properties": {
        "exact": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "position": { "$ref": "#/definitions/position" },
        "selectors": {
          "type": "array",
          "items": { "$ref": "#/definitions/selector" }
        }
      }
    },
    "goldenClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goldenClaimId", "claimText", "evidence", "expectedDisposition"],
      "properties": {
        "goldenClaimId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "claimText": { "type": "string", "minLength": 1 },
        "normalizedMeaning": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/definitions/evidence" },
        "expectedDisposition": { "const": "EXTRACT" },
        "semanticAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goldenClaimId", "relevance"],
      "properties": {
        "goldenClaimId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "relevance": { "enum": [0, 1, 2] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "searchQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queryId",
        "queryText",
        "language",
        "queryType",
        "kValues",
        "expectedNoResult",
        "judgments"
      ],
      "properties": {
        "queryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "queryText": { "type": "string", "minLength": 1 },
        "language": { "enum": ["ko", "en", "ko-en-mixed"] },
        "queryType": {
          "enum": [
            "exact-keyword",
            "natural-language",
            "synonym",
            "notation-variation",
            "ko-inflection",
            "no-result"
          ]
        },
        "kValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 100 }
        },
        "expectedNoResult": { "type": "boolean" },
        "judgments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/judgment" }
        }
      }
    }
  }
}
