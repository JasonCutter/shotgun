{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shotgun.local/quality/golden-corpus-manifest.v1.schema.json",
  "title": "Shotgun Golden Corpus Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "corpusId",
    "corpusVersion",
    "labelSetRevision",
    "title",
    "description",
    "createdAt",
    "updatedAt",
    "digestAlgorithm",
    "corpusDigest",
    "caseIds",
    "licenseSummary",
    "dataPolicy"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "corpusId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "corpusVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "labelSetRevision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "digestAlgorithm": { "const": "sha256" },
    "corpusDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "licenseSummary": { "type": "string", "minLength": 1 },
    "dataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "containsProductionData", "liveProviderEligible"],
      "properties": {
        "classification": { "const": "SYNTHETIC" },
        "containsProductionData": { "const": false },
        "liveProviderEligible": { "type": "boolean" }
      }
    }
  }
}
