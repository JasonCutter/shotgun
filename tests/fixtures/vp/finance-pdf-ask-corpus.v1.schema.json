{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shotgun.local/schemas/vp/finance-pdf-ask-corpus.v1.schema.json",
  "title": "VP Finance PDF Ask Corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "corpusId",
    "corpusVersion",
    "labelSetRevision",
    "corpusDigest",
    "labelReviewStatus",
    "source",
    "questions"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "corpusId": { "const": "shotgun-vp-finance-pdf-ask" },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "labelSetRevision": { "type": "integer", "minimum": 1 },
    "corpusDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "labelReviewStatus": { "const": "CANDIDATE" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "pageCount", "dataClassification"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pageCount": { "const": 10 },
        "dataClassification": { "const": "USER_PROVIDED" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "page", "question", "expectedAnswerTerms", "expectedEvidenceTerms"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "page": { "type": "integer", "minimum": 1, "maximum": 10 },
          "question": { "type": "string", "minLength": 1 },
          "expectedAnswerTerms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expectedEvidenceTerms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
