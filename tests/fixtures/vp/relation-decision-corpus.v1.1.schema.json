{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shotgun.local/schemas/vp/relation-decision-corpus.v1.1.schema.json",
  "title": "VP relation decision evaluation corpus v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "corpusId",
    "corpusVersion",
    "labelSetRevision",
    "corpusDigest",
    "labelReviewStatus",
    "dataClassification",
    "licenseSummary",
    "cases"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "corpusId": {
      "const": "shotgun-vp-relation-synthetic"
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1
    },
    "labelSetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "corpusDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "labelReviewStatus": {
      "enum": ["CANDIDATE", "REVIEWED", "APPROVED", "RETIRED"]
    },
    "dataClassification": {
      "const": "SYNTHETIC"
    },
    "licenseSummary": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "left", "right", "allowedChoices", "dimension", "rationale"],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "allowedChoices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["EQUIVALENT", "QUALIFIES", "CONTRADICTS", "RELATED", "UNRESOLVED"]
            }
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
